      "name": "解析时间",
      "func": "// time_parse.js — 自然语言时间解析（Home Assistant 历史查询子流程用）\n//\n// 把用户表述的中文/英文混合时间，解析成本地时区的 Date（与用户说的墙上时钟一致）。\n// 例：昨晚23:12 / 昨天11:00 / 前天08:30 / 今天09:15 / 现在 / 过去8小时 / 8h / 1d /\n//     本周 / 本周日 / 2026-07-19T23:12 / 2026-07-19 23:12\n//\n// 本文件整体可作为 NR function 节点体使用：\n//   - 纯函数 parseNaturalTime / toHAISO 在节点作用域内可用；\n//   - 底部的 module.exports 守卫在 NR 中会被跳过（NR 不定义 module）。\n// 也可被 Node 直接 require 做单元测试。\n\nfunction _startOfDay(d) {\n  const x = new Date(d);\n  x.setHours(0, 0, 0, 0);\n  return x;\n}\n\nfunction _addDays(d, n) {\n  const x = new Date(d);\n  x.setDate(x.getDate() + n);\n  return x;\n}\n\nfunction _atTime(day, hh, mm, ss) {\n  const x = new Date(day);\n  x.setHours(hh, mm || 0, ss == null ? 0 : ss, 0);\n  return x;\n}\n\n// 从文本中搜索 \"HH:MM\" / \"H:MM\" / \"HH：MM\" → [h, m]；否则 null。\n// 用搜索（非 ^...$ 锚定），以便 \"昨晚23:12\" 这类带前缀的表述也能取出时刻。\nfunction _parseHm(s) {\n  const m = /(\\d{1,2})[:：](\\d{1,2})/.exec(s);\n  if (!m) return null;\n  return [parseInt(m[1], 10), parseInt(m[2], 10)];\n}\n\n// 把 Date 格式化为 HA history API 友好的 ISO 8601（带本地时区偏移）。\n// HA 内部以 UTC 存储；传入带偏移的 ISO 可被正确换算为该墙上时刻，避免被当成 UTC 而偏移 8 小时。\nfunction toHAISO(d) {\n  const off = -d.getTimezoneOffset(); // 分钟，东半球为正\n  const sign = off >= 0 ? \"+\" : \"-\";\n  const abs = Math.abs(off);\n  const oh = String(Math.floor(abs / 60)).padStart(2, \"0\");\n  const om = String(abs % 60).padStart(2, \"0\");\n  const Y = d.getFullYear();\n  const M = String(d.getMonth() + 1).padStart(2, \"0\");\n  const D = String(d.getDate()).padStart(2, \"0\");\n  const h = String(d.getHours()).padStart(2, \"0\");\n  const mi = String(d.getMinutes()).padStart(2, \"0\");\n  const s = String(d.getSeconds()).padStart(2, \"0\");\n  return `${Y}-${M}-${D}T${h}:${mi}:${s}${sign}${oh}:${om}`;\n}\n\nfunction parseNaturalTime(text, now) {\n  if (text == null) return null;\n  text = String(text).trim();\n  if (!text) return null;\n  now = now || new Date();\n  const lower = text.toLowerCase();\n\n  // 0) 绝对 ISO 带时刻：2026-07-19T23:12 / 2026-07-19 23:12 / 2026/07/19 23:12\n  let m = /^(\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})[ T](\\d{1,2})[:：](\\d{1,2})/.exec(text);\n  if (m) {\n    return new Date(+m[1], +m[2] - 1, +m[3], +m[4], +m[5], 0, 0);\n  }\n  // 仅日期：2026-07-19 → 当天 00:00\n  m = /^(\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})$/.exec(text);\n  if (m) {\n    return _atTime(new Date(+m[1], +m[2] - 1, +m[3]), 0, 0);\n  }\n\n  // 1) 紧凑相对：8h / 1d / 24h / 30min\n  m = /^(\\d+)\\s*(h|d|min|m)$/i.exec(lower);\n  if (m) {\n    const n = parseInt(m[1], 10);\n    const u = m[2].toLowerCase();\n    const ms = u === \"d\" ? n * 86400000 : u === \"min\" || u === \"m\" ? n * 60000 : n * 3600000;\n    return new Date(now.getTime() - ms);\n  }\n\n  // 2) 相对偏移：过去8小时 / 8小时前 / 近3天 / 30分钟前 / 2天前\n  m = /(?:过去|近)?\\s*(\\d+)\\s*(小时|h|钟头|分钟|min|天|日|d)\\s*(前|之内|内|以前)?/.exec(text);\n  if (m) {\n    const n = parseInt(m[1], 10);\n    const unit = m[2];\n    let ms;\n    if (unit === \"分钟\" || unit === \"min\") ms = n * 60000;\n    else if (unit === \"小时\" || unit === \"h\" || unit === \"钟头\") ms = n * 3600000;\n    else ms = n * 86400000; // 天/日/d\n    return new Date(now.getTime() - ms);\n  }\n\n  // 3) 现在\n  if (/^(现在|目前|此刻|当前|now)$/i.test(lower)) return new Date(now.getTime());\n\n  // 4) 日期词 + 可选时段/时刻\n  const dw = /(今天|今日|当天|昨天|昨日|前天|大前天|明天|明日|明早|明晚|明晨|明午|今早|今晨|今午|中午|今晚|昨晚)/.exec(text);\n  if (dw) {\n    const w = dw[1];\n    let base;\n    if (w === \"今天\" || w === \"今日\" || w === \"当天\" || w === \"今早\" || w === \"今晨\" ||\n        w === \"今午\" || w === \"中午\" || w === \"今晚\") {\n      base = _startOfDay(now);\n    } else if (w === \"昨天\" || w === \"昨日\" || w === \"昨晚\") {\n      base = _addDays(_startOfDay(now), -1);\n    } else if (w === \"前天\") {\n      base = _addDays(_startOfDay(now), -2);\n    } else if (w === \"大前天\") {\n      base = _addDays(_startOfDay(now), -3);\n    } else {\n      base = _addDays(_startOfDay(now), 1); // 明天/明日/明早/明晚/明晨/明午\n    }\n    const hm = _parseHm(text);\n    let hh = hm ? hm[0] : 0;\n    let mm = hm ? hm[1] : 0;\n    if (/下午|傍晚|晚上|晚间|明晚|今晚|昨晚/.test(text) && hm && hh < 12) hh += 12;\n    if (/凌晨|清晨/.test(text) && hm && hh === 12) hh = 0;\n    if (/中午|今午|明午/.test(text) && !hm) { hh = 12; mm = 0; }\n    if (/早上|上午|今早|明早|今晨/.test(text) && !hm) { hh = 8; mm = 0; }\n    if (/今晚|晚上|傍晚|昨晚/.test(text) && !hm) { hh = 20; mm = 0; } // 晚上无时刻兜底 20:00\n    return _atTime(base, hh, mm);\n  }\n\n  // 5) 本周日 23:59:59（须先于「本周」判定，否则「本周日」会被「本周」子串抢先）\n  if (/本周日|本周末|周日|周天/.test(text)) {\n    const d = _startOfDay(now);\n    const dow = (d.getDay() + 6) % 7;\n    return _atTime(_addDays(d, 6 - dow), 23, 59, 59);\n  }\n  // 本周一 00:00 / 本周（本周一）\n  if (/本周一|本周/.test(text)) {\n    const d = _startOfDay(now);\n    const dow = (d.getDay() + 6) % 7; // 周一=0\n    return _addDays(d, -dow);\n  }\n\n  // 6) 仅 HH:MM（无日期词）→ 今天该时刻\n  const hm2 = _parseHm(text);\n  if (hm2) return _atTime(_startOfDay(now), hm2[0], hm2[1]);\n\n  return null;\n}\n\n// 解析一对 [start, end]；end 缺省视为 now。返回 {start, end, start_iso, end_iso} 或 null。\nfunction parseWindow(startText, endText, now) {\n  now = now || new Date();\n  const s = parseNaturalTime(startText, now);\n  if (!s) return null;\n  const e = endText ? parseNaturalTime(endText, now) : new Date(now.getTime());\n  if (!e) return null;\n  return {\n    start: s,\n    end: e,\n    start_iso: toHAISO(s),\n    end_iso: toHAISO(e),\n  };\n}\n\nif (typeof module !== \"undefined\" && module.exports) {\n  module.exports = { parseNaturalTime, toHAISO, parseWindow, _startOfDay, _addDays, _atTime, _parseHm };\n}\n\nfunction _feedNode(msg, start, end) {\n  // WB26 修正：api-get-history 节点(entityIdType schema 仅允许 equals/regex) 无 msg 动态路径，\n  // 但官方文档明确 entityId/startDate/endDate 均可经 msg.payload 传入并覆盖配置\n  // （\"All properties of msg.payload ... Will override the configuration if passed in\"）。\n  // 故这里直接把字面量 ISO 与 entityId 写进 msg.payload，节点原生读取并覆盖空配置。\n  // 必须先对象化 payload：数字/字符串/数组 payload 给原始值赋属性会被 JS 静默忽略（#107 根因）。\n  if (!msg.payload || typeof msg.payload !== \"object\" || Array.isArray(msg.payload)) {\n    msg.payload = {};\n  }\n  msg.payload.startDate = toHAISO(start);\n  msg.payload.endDate = toHAISO(end);\n  msg.payload.entityId = msg.entity || \"\";\n  return msg;\n}\n\nconst now = new Date();\nconst s = parseNaturalTime(msg.start, now);\nlet e = parseNaturalTime(msg.end, now) || new Date(now.getTime());\n// 保留原行为：过去 end 钳到 now 之后（api-get-history 过去 end 返回空，钳到 now 语义=查到现在）\nif (e.getTime() < now.getTime()) e = new Date(now.getTime() + 60000);\n// G1 future-guard：未来 start（如凌晨跑「今日08:00」）→ 钳到 now，避免 start>end 反向窗口\n// → HA 抛 ValidationError: startDate must be a valid date；并兜底交换防反向窗口。\nif (s && s.getTime() > now.getTime()) s = new Date(now.getTime());\nif (s && e && s.getTime() > e.getTime()) { const _t = s; s = e; e = _t; }\nmsg._hist_start = toHAISO(s);\nmsg._hist_end = toHAISO(e);\nreturn _feedNode(msg, s, e);\n",
