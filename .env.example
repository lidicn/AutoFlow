# AutoFlow Gateway 环境变量示例（复制为 .env 后填真实值）
# 注意：HASS_TOKEN / NR_PASS / BARK_KEY 是网关独占凭证，切勿透传给任何 agent。
#
# 💡 连接类配置（HA / Node-RED / Bark）也可以直接在 WebUI「设置 → 连接配置」里填，
#    保存后写入 data/<env>/connections.json（该目录已 gitignore）并立即生效、无需重启。
#    界面里填过的字段优先级高于这里的 .env 值。

# ⚠️ 环境变量前缀双读（审计报告 BUG-3 修复）：网关对下方所有 AUTOFLLOW_* 变量同时兼容
#    AUTOFLOW_* 前缀——AUTOFLOW_* 优先，AUTOFLLOW_* 回退。即你写 AUTOFLLOW_ENV 或
#    AUTOFLOW_ENV 都生效；若两者都设，AUTOFLOW_* 胜出。新部署建议统一用 AUTOFLOW_ 前缀，
#    历史 AUTOFLLOW_ 配置无需改动即可继续工作。

# 环境分级：staging / prod（仅用于 data/ 子目录隔离；NR 默认 1880）
# 双读：AUTOFLOW_ENV / AUTOFLLOW_ENV 皆可
AUTOFLLOW_ENV=staging

# HA 连接（网关独占）
# 容器内访问宿主 HA 用 http://host.docker.internal:8123，不要写 localhost
HASS_SERVER=http://127.0.0.1:8123
HASS_TOKEN=

# NR 连接（网关独占），默认 http://localhost:1880
NR_URL=http://127.0.0.1:1880
NR_USER=
NR_PASS=

# Bark 推送（可选）：网关需要人工审核时给手机发通知；不填则相关推送静默跳过。
# 自建服务填自己的地址，官方服务填 https://api.day.app
BARK_SERVER=
BARK_KEY=

# MCP 服务
# 安全默认：仅本机回环 127.0.0.1。需局域网/公网暴露时再显式设 0.0.0.0
# （会暴露可控制物理设备的网关，谨慎！生产建议配合反向代理 + TLS）。
AF_MCP_HOST=127.0.0.1
AF_MCP_PORT=8000
AF_MCP_PATH=/mcp
# 跨域浏览器 MCP 客户端（如 deepseek++ 扩展）需把自身 origin 加入此 allowlist
# （逗号分隔；默认空 = 仅同源反射，任意跨域 Origin 一律拒绝）。
AF_MCP_CORS_ORIGINS=

# 防御层（可选覆盖）
AF_BLAST_RADIUS=1
AF_PROTECTED_LABELS=core,system,AutoFlow
AF_ELEVATED_DOMAINS=lock,valve,water_heater,alarm_control_panel,garage_door
AF_AUTO_APPROVE=false

# 驱动路径（指向已有 skills 中的客户端，不允许 agent 改动）
HA_CLIENT_PATH=
NR_CLIENT_PATH=

# ───────────────────────────────────────────────────────────────────────────
# 白箱闸 / 护栏 / 限流（均双读：AUTOFLOW_* 优先，AUTOFLLOW_* 回退；下方用 AUTOFLLOW_ 列举）
# 这些变量直接影响「部署是否被拦 / prod 写护栏 / 限速」，改前务必清楚后果。
# ───────────────────────────────────────────────────────────────────────────

# 运行时数据目录（快照 / 待确认 / 备份持久化）。容器内默认 /data；改需同步挂载。
# 双读：AUTOFLOW_DATA_DIR / AUTOFLLOW_DATA_DIR
AUTOFLLOW_DATA_DIR=/data

# 白箱部署闸门开关（影响 DSL 提案部署是否拦截）。非 0=开，0=关。
# 双读：AUTOFLOW_WHITEBOX_BLOCK_ON_LINT_ERROR / AUTOFLLOW_WHITEBOX_BLOCK_ON_LINT_ERROR
AUTOFLLOW_WHITEBOX_BLOCK_ON_LINT_ERROR=1
# 逻辑不可达拦截（默认关，仅附 logic 段不阻止部署）。0=关 1=开。
# 双读：AUTOFLOW_WHITEBOX_BLOCK_ON_LOGIC_ERROR / AUTOFLLOW_WHITEBOX_BLOCK_ON_LOGIC_ERROR
AUTOFLLOW_WHITEBOX_BLOCK_ON_LOGIC_ERROR=0
# schema error 拦截（默认开）。0=关 1=开。
# 双读：AUTOFLOW_WHITEBOX_BLOCK_ON_SCHEMA_ERROR / AUTOFLLOW_WHITEBOX_BLOCK_ON_SCHEMA_ERROR
AUTOFLLOW_WHITEBOX_BLOCK_ON_SCHEMA_ERROR=1
# 部署前实跑一次 E2E 实机验证闸（默认关）。0=关 1=开。
# 双读：AUTOFLOW_WHITEBOX_REQUIRE_E2E / AUTOFLLOW_WHITEBOX_REQUIRE_E2E
AUTOFLLOW_WHITEBOX_REQUIRE_E2E=0
# 失败部署重试预算（滑动窗口内失败次数上限）与窗口（分钟）。
# 双读：AUTOFLOW_WHITEBOX_RETRY_BUDGET / AUTOFLLOW_WHITEBOX_RETRY_BUDGET
#       AUTOFLOW_WHITEBOX_RETRY_WINDOW_MIN / AUTOFLLOW_WHITEBOX_RETRY_WINDOW_MIN
AUTOFLLOW_WHITEBOX_RETRY_BUDGET=5
AUTOFLLOW_WHITEBOX_RETRY_WINDOW_MIN=10

# 自愈重试预算（0=禁用自主重试，一次失败即停）与窗口（分钟）。
# 双读：AUTOFLOW_SELFHEAL_BUDGET / AUTOFLLOW_SELFHEAL_BUDGET
#       AUTOFLOW_SELFHEAL_WINDOW_MIN / AUTOFLLOW_SELFHEAL_WINDOW_MIN
AUTOFLLOW_SELFHEAL_BUDGET=3
AUTOFLLOW_SELFHEAL_WINDOW_MIN=10

# WebUI 限流（!=0 即开）。全局每分钟上限 / 登录每分钟上限。
# 双读：AUTOFLOW_RATE_LIMIT_ENABLED / AUTOFLLOW_RATE_LIMIT_ENABLED
#       AUTOFLOW_RATE_LIMIT_GLOBAL_PER_MIN / AUTOFLLOW_RATE_LIMIT_GLOBAL_PER_MIN
#       AUTOFLOW_RATE_LIMIT_LOGIN_PER_MIN / AUTOFLLOW_RATE_LIMIT_LOGIN_PER_MIN
AUTOFLLOW_RATE_LIMIT_ENABLED=1
AUTOFLLOW_RATE_LIMIT_GLOBAL_PER_MIN=1000
AUTOFLLOW_RATE_LIMIT_LOGIN_PER_MIN=30

# history_* 子流程自动安装（默认开，设 0 关闭）。
# 双读：AUTOFLOW_HIST_AUTOINSTALL / AUTOFLLOW_HIST_AUTOINSTALL
AUTOFLLOW_HIST_AUTOINSTALL=1

# debug 回读桥（默认开，设 0 关闭）。DEBUG_* 为缓冲容量/TTL 等内部调参。
# 双读：AUTOFLOW_DEBUG_BRIDGE / AUTOFLLOW_DEBUG_BRIDGE（及 AUTOFLOW_DEBUG_* / AUTOFLLOW_DEBUG_*）
AUTOFLLOW_DEBUG_BRIDGE=1

# ACP 会话 TTL（秒）与清理节流间隔（秒）。
# 双读：AUTOFLOW_ACP_SESSION_TTL_SECONDS / AUTOFLLOW_ACP_SESSION_TTL_SECONDS
#       AUTOFLOW_ACP_SESSION_SWEEP_INTERVAL_SECONDS / AUTOFLLOW_ACP_SESSION_SWEEP_INTERVAL_SECONDS
AUTOFLLOW_ACP_SESSION_TTL_SECONDS=1800
AUTOFLLOW_ACP_SESSION_SWEEP_INTERVAL_SECONDS=300

# nr_client token TTL（秒，仅当直连 NR 时生效）。
# 双读：AUTOFLOW_NR_TOKEN_TTL / AUTOFLLOW_NR_TOKEN_TTL
AUTOFLLOW_NR_TOKEN_TTL=86400
